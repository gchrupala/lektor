{
  "name": "Lektor",
  "short_name": "Lektor",
  "description": "Reads papers, theses and other PDFs aloud, whole or by chapter. Czyta na głos artykuły i prace dyplomowe, całe albo wybrany rozdział.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f1ea",
  "theme_color": "#f4f1ea",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "pdf", "accept": ["application/pdf", ".pdf"] }]
    }
  },
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"] } }
  ]
}
